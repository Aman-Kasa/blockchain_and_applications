# Which entry of src/contracts/deployments.json the dApp uses.
# "localhost" (after running deploy.js against `npx hardhat node`) or "sepolia".
# If unset, the dApp uses localhost when it has been deployed, otherwise sepolia.
VITE_NETWORK=localhost

# Optional: override the RPC URL used for read-only calls.
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
