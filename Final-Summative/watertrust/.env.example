# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# Sepolia RPC endpoint (Alchemy, Infura, or a public one such as https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a TEST-ONLY MetaMask account that holds Sepolia ETH (never use a wallet with real funds)
PRIVATE_KEY=

# Optional: Etherscan API key, only needed to verify the source code on Etherscan
ETHERSCAN_API_KEY=

# Optional: amount of Sepolia ETH sent to each demo wallet (sensor + 3 witnesses)
DEMO_FUND_ETH=0.003
